<?xml version="1.0" encoding="utf-8"?>
<!--
  Piko 自适应启动器图标前景层。
  画布 108x108，中心 (54,54)，主体尺寸按 90% 缩放（scale=1.24），留出更为宽松自然的呼吸感留白。
  猫耳高度调矮，呈现娇憨可爱的小猫耳比例。
  底色层为 PikPak 标志性品牌蓝 (#306EFF)。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="24"
        android:pivotY="24.5"
        android:scaleX="1.24"
        android:scaleY="1.24"
        android:translateX="30"
        android:translateY="29.5">

        <!-- 左挺立萌小猫耳 (适度矮化，比例更娇憨可爱) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M10.5,16.8 C10.5,14.0 12.2,11.0 13.5,9.8 C14.2,9.0 15.5,9.2 16.0,10.2 L20.8,15.2 Z" />

        <!-- 右挺立萌小猫耳 (适度矮化，比例更娇憨可爱) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M37.5,16.8 C37.5,14.0 35.8,11.0 34.5,9.8 C33.8,9.0 32.5,9.2 32.0,10.2 L27.2,15.2 Z" />

        <!-- 圆润饱满的 Squircle 机器人面庞 (rx=7.5) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M15,15 H33 A7.5,7.5 0 0 1 40.5,22.5 V32.5 A7.5,7.5 0 0 1 33,40 H15 A7.5,7.5 0 0 1 7.5,32.5 V22.5 A7.5,7.5 0 0 1 15,15 Z" />

        <!-- 左胶囊眼 -->
        <path
            android:fillColor="#306EFF"
            android:pathData="M17.5,22.5 H17.5 A1.7,1.7 0 0 1 19.2,24.2 V27.0 A1.7,1.7 0 0 1 17.5,28.7 H17.5 A1.7,1.7 0 0 1 15.8,27.0 V24.2 A1.7,1.7 0 0 1 17.5,22.5 Z" />

        <!-- 右胶囊眼 -->
        <path
            android:fillColor="#306EFF"
            android:pathData="M30.5,22.5 H30.5 A1.7,1.7 0 0 1 32.2,24.2 V27.0 A1.7,1.7 0 0 1 30.5,28.7 H30.5 A1.7,1.7 0 0 1 28.8,27.0 V24.2 A1.7,1.7 0 0 1 30.5,22.5 Z" />

        <!-- 治愈微笑 -->
        <path
            android:strokeColor="#306EFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:pathData="M20.8,31.8 Q24,35.5 27.2,31.8" />
    </group>

</vector>
